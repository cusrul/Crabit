class SnakeGameApp : public Application {
public:
    const char* getAppName() override { return "SNAKE"; }
    
    // 声明我是独占模式！
    AppMode getMode() override { return APP_MODE_EXCLUSIVE; }

    // 系统会直接调用这个函数，直到你主动 return 才会切回桌面
    void runExclusive(Canvas* canvas, InputDriver* input) override {
        bool playing = true;
        int x = 64, y = 32;

        while (playing) {
            // =========================================================
            // 【SDL 防卡死补丁】维持窗口响应。上真机(AmebaD)时可以删掉这段！
            SDL_Event sdl_e;
            while (SDL_PollEvent(&sdl_e)) {
                if (sdl_e.type == SDL_QUIT) exit(0);
                ((SDLInputDriver*)input)->injectSDLEvent(sdl_e); 
            }
            // =========================================================

            // 1. 自己独占读取按键
            UIEvent e = input->poll();
            if (e.type == EVT_BACK) playing = false; // 按返回键退出死循环！
            if (e.type == EVT_LEFT)  x -= 2;
            if (e.type == EVT_RIGHT) x += 2;
            if (e.type == EVT_UP)    y -= 2;
            if (e.type == EVT_DOWN)  y += 2;
            
            // 2. 自己独占清屏画图
            canvas->clear();
            canvas->drawRoundRect(x, y, 4, 4, 1, C_WHITE); // 画蛇头
            canvas->display();
            
            // 3. 自己的延时节奏 (不用管系统的 60fps 限制)
            SDL_Delay(30); 
        }
    }
};




// =========================================================
// 后台服务：安全守卫 (默默监控系统状态，无界面)
// =========================================================
class SecurityDaemon : public Application {
private:
    uint32_t lastCheckTime = 0;
    int attackCount = 0; // 记录攻击次数

public:
    const char* getAppName() override { return "DAEMON.SEC"; }
    
    // 声明我是纯后台服务！
    AppMode getMode() override { return APP_MODE_BACKGROUND; }

    void onCreate() override {
        lastCheckTime = hal_get_ticks();
    }

    void onTick() override {
        uint32_t now = hal_get_ticks();
        
        // 缩短到每 3 秒检查一次
        if (now - lastCheckTime > 3000) {
            
            // 🚨 为了测试，我们让它 100% 触发攻击！
            attackCount++;
            
            // 拼接一个带数字的字符串，让你能看出它是活的
            char msg[32];
            snprintf(msg, sizeof(msg), "INTRUSION x%d", attackCount);

            // 弹出全局 Toast (不管现在前台在什么页面，它都会强制浮在最上面)
            Popup::showToast(msg, 1500); 

            // 通知 OS 刷新屏幕（非常重要：后台任务修改了 UI 必须主动告诉系统重绘）
            if (WindowManager::instance) WindowManager::instance->markDirty();
            
            lastCheckTime = now;
        }
    }

    Widget* buildUI() override { return nullptr; } 
};





