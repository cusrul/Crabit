// =========================================================
// 3. 主程序入口
// =========================================================
int main(int argc, char *argv[]) {
  // 给 NanoUI 注入 SDL 的时间能力 (解决平台强耦合)
  HAL_Time::init([]() -> uint32_t { return SDL_GetTicks(); });

  if (SDL_Init(SDL_INIT_VIDEO) < 0) return -1;

  SDL_Window *window = SDL_CreateWindow(
      "NanoUI CyberDeck", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
      128 * 4, 64 * 4, SDL_WINDOW_SHOWN);
  SDL_Renderer *renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_ACCELERATED);
  SDL_RenderSetScale(renderer, 4, 4);

  SDLAdapter canvas(renderer, 128, 64);
  SDLInputDriver input;
  WindowManager wm(&canvas, &input);
  Navigator::init(&wm);

  // =======================================================
  // 🚨 【核心修复】NANO-OS 初始化：注入系统的 Canvas 和 Input
  // 必须有这一步，AppManager 才能把硬件借给贪吃蛇！
  // =======================================================
  AppManager::init(&canvas, &input);
  
  // 推入主菜单 (包裹上 PopupRoot 以支持全局弹窗)
  wm.push(new PopupRoot(buildMainMenu()));
  AppManager::launch(new SecurityDaemon());
  bool running = true;
  while (running) {
    SDL_Event e;
    while (SDL_PollEvent(&e)) {
      if (e.type == SDL_QUIT)
        running = false;
      input.injectSDLEvent(e);
    }

    // =======================================================
    // 🚨 NANO-OS 核心调度三部曲
    // =======================================================
    AppManager::tick();  // 1. [逻辑层] 驱动处于协同模式的后台 App
    wm.update();         // 2. [事件层] 引擎计算 UI 变动与焦点
    wm.markDirty();
    wm.drawFrame();      // 3. [渲染层] 把数据画到屏幕上
    // =======================================================

    SDL_Delay(16);
  }

  SDL_DestroyRenderer(renderer);
  SDL_DestroyWindow(window);
  SDL_Quit();
  return 0;
}